{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallax.local/schemas/aqlen/readiness_score.schema.json",
  "title": "Readiness Score",
  "type": "object",
  "required": ["score_id", "target_protocol", "axis_scores", "weighted_score", "readiness_band", "claim_boundary"],
  "properties": {
    "score_id": {"type": "string"},
    "device_or_platform_id": {"type": "string"},
    "target_protocol": {"type": "string"},
    "axis_scores": {"type": "object"},
    "weights": {"type": "object"},
    "weighted_score": {"type": "number", "minimum": 0, "maximum": 1},
    "readiness_band": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "evidence_links": {"type": "array", "items": {"type": "string"}}
  }
}
