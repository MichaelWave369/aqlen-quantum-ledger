{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqlen.local/schemas/dashboard_payload.schema.json",
  "title": "AQLEN Dashboard Payload",
  "description": "Frontend-ready dashboard payload for AQLEN receipt graph renderers. This schema documents structure only; scientific confidence is carried by node status, warnings, boundary cards, and global claim boundary fields.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "dashboard_payload_version",
    "graph_id",
    "graph_version",
    "nodes",
    "edges",
    "summary_cards",
    "boundary_cards",
    "focus_trace",
    "global_claim_boundary"
  ],
  "properties": {
    "dashboard_payload_version": {
      "type": "string",
      "minLength": 1
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string"
    },
    "global_claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "summary_cards": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "label", "group", "status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "claim_boundary": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_status": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "source", "target", "type", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        }
      }
    },
    "boundary_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["node_id", "boundary"],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string"
          }
        }
      }
    },
    "focus_trace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "focus_id": {
          "type": "string"
        },
        "upstream": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_item"
          }
        },
        "downstream": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_item"
          }
        }
      }
    }
  },
  "$defs": {
    "trace_item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["node_id"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "via_edge_id": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
