{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallax.local/aqlen/schemas/module_registry_entry.schema.json",
  "title": "AQLEN Module Registry Entry",
  "type": "object",
  "required": [
    "id",
    "number",
    "name",
    "purpose",
    "inputs",
    "outputs",
    "boundary_note"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable module identifier."
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "name": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "boundary_note": {
      "type": "string",
      "description": "Claim-boundary or interpretation guard for this module."
    }
  },
  "additionalProperties": false
}
