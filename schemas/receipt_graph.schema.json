{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelWave369/aqlen-quantum-ledger/schemas/receipt_graph.schema.json",
  "title": "AQLEN Receipt Graph",
  "type": "object",
  "required": ["graph_id", "version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "graph_id": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "created_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "type": {
            "type": "string",
            "enum": [
              "evidence_anchor",
              "qubit_receipt",
              "noise_event",
              "calibration_receipt",
              "readiness_score",
              "module"
            ]
          },
          "label": {"type": "string"},
          "status": {"type": "string"},
          "claim_boundary": {"type": "string"},
          "source_path": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {
            "type": "string",
            "enum": [
              "supports",
              "measured_on",
              "observed_after",
              "mitigated_by",
              "updates",
              "feeds_module",
              "derived_from"
            ]
          },
          "note": {"type": "string"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
